{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "bluewage": {
      "projectType": "application",
      "root": "frontend",
      "sourceRoot": "frontend/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/bluewage",
            "index": "frontend/src/index.html",
            "browser": "frontend/src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "frontend/public" }],
            "styles": ["frontend/src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "bluewage:build:production" },
            "development": { "buildTarget": "bluewage:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
